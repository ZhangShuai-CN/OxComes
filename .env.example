# ==== 复制为 .env 并填入你的配置（.env 已被 .gitignore 忽略，绝不提交）====

# FMP API Key（免费注册: https://site.financialmodelingprep.com/developer/dashboard）
# 财报/IPO 日历、估值三表、SPY 成分数据需要；仅做回测时可不填
FMP_API_KEY=

# 钉钉机器人推送（可选，默认关闭；NOTIFY_ENABLED=true 时每日消息同时推送钉钉）
NOTIFY_ENABLED=false
DINGTALK_TOKEN=
DINGTALK_SECRET=

# 本地服务
HOST=127.0.0.1
PORT=8300
